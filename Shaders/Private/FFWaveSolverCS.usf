#include "/Engine/Public/Platform.ush"

Texture2D<float>    PreviousHeight;
RWTexture2D<float> CurrentHeight;
RWTexture2D<float> Velocity;

float DeltaTime;
float Gravity;
float Damping;
float WaveSpeed;
int   GridWidth;
int   GridHeight;

// Native Disturbance Inputs
int   DisturbanceX;
int   DisturbanceY;
float DisturbanceStrength;
int   DisturbanceRadius;

[numthreads(8, 8, 1)]
void FFWaveSolverCS(uint3 ThreadId : SV_DispatchThreadID)
{
    int X = (int)ThreadId.x;
    int Y = (int)ThreadId.y;

    if (X >= GridWidth || Y >= GridHeight)
        return;

    // Handle edge reflection mirroring logic
    int SampleX = X;
    int SampleY = Y;
    if (X == 0) SampleX = 1;
    else if (X == GridWidth - 1) SampleX = GridWidth - 2;
    if (Y == 0) SampleY = 1;
    else if (Y == GridHeight - 1) SampleY = GridHeight - 2;

    if (X == 0 || Y == 0 || X == GridWidth - 1 || Y == GridHeight - 1)
    {
        CurrentHeight[int2(X, Y)] = PreviousHeight[int2(SampleX, SampleY)];
        Velocity[int2(X, Y)]      = Velocity[int2(SampleX, SampleY)] * Damping;
        return;
    }

    float H      = PreviousHeight[int2(X,     Y    )];
    float HRight = PreviousHeight[int2(X + 1, Y    )];
    float HLeft  = PreviousHeight[int2(X - 1, Y    )];
    float HUp    = PreviousHeight[int2(X,     Y + 1)];
    float HDown  = PreviousHeight[int2(X,     Y - 1)];

    // Shallow Water Wave Equation Math
    float Laplacian = HRight + HLeft + HUp + HDown - 4.0f * H;
    float V = Velocity[int2(X, Y)];
    
    V += Laplacian * Gravity * WaveSpeed * DeltaTime;
    V *= Damping;

    float NewH = H + V * DeltaTime;

    // --- APPLY DIRECT GPU RADIAL DISTURBANCE ---
    if (DisturbanceStrength != 0.0f && DisturbanceRadius > 0)
    {
        float Dist = sqrt(pow((float)(X - DisturbanceX), 2) + pow((float)(Y - DisturbanceY), 2));
        if (Dist <= (float)DisturbanceRadius)
        {
            // Direct Cosine Falloff matching the CPU side logic perfectly
            float Falloff = cos((Dist / (float)DisturbanceRadius) * (3.14159265f * 0.5f));
            NewH += DisturbanceStrength * Falloff;
        }
    }

    NewH = clamp(NewH, -5.0f, 5.0f);

    CurrentHeight[int2(X, Y)] = NewH;
    Velocity[int2(X, Y)]      = V;
}